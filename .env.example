# Copy to .env and adjust. Never commit .env. Never put secrets in VITE_* variables.
NODE_ENV=development
LOG_LEVEL=info

# API
HOST=127.0.0.1
PORT=4000
# Must include the web app origin (browsers send Origin on same-origin POSTs).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY=false
BODY_LIMIT=256kb

# MongoDB replica set (needed for transactions). `npm run dev:db` starts one locally on port 27027.
# Without it the API serves only the health endpoints (no sign-in).
# MONGODB_URI=mongodb://127.0.0.1:27027/?replicaSet=rs0
MONGODB_DB_NAME=bizmgmt_dev

# Worker
WORKER_POLL_MS=1000

# Web (public, bundled into the browser build)
VITE_API_BASE=/api/v1

# Auth (Phase 3). APP_SECRET is required in production: generate 48+ random characters and keep it in a secret store.
# APP_SECRET=
PUBLIC_APP_URL=http://localhost:5173
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
# SIGNUP_ENABLED=true        # default: true outside production, false in production
# MFA_ENFORCEMENT=off        # default: off outside production, privileged in production
# MAIL_TRANSPORT=file        # default: file (.artifacts/mail) outside production, disabled in production

# Generated documents (Phase 6). The API (downloads) and the worker (rendering) must share the same storage.
# STORAGE_DRIVER=local       # default: local outside production, disabled in production (S3 arrives with deployment)
# STORAGE_DIR=.artifacts/storage
