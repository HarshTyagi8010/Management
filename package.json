{
  "name": "bizmgmt",
  "private": true,
  "version": "0.1.0",
  "description": "CRM, GST billing, inventory and business management for Indian SMEs (modular monolith).",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <27"
  },
  "workspaces": [
    "packages/contracts",
    "packages/domain",
    "packages/ui",
    "apps/api",
    "apps/worker",
    "apps/web"
  ],
  "scripts": {
    "build": "npm run build:node && npm run build -w @bizmgmt/web",
    "build:node": "tsc -b packages/contracts packages/domain apps/api apps/worker",
    "typecheck": "tsc -b packages/contracts packages/domain apps/api apps/worker && tsc -p apps/api/tsconfig.test.json && npm run typecheck -w @bizmgmt/ui && npm run typecheck -w @bizmgmt/web",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "npm run dev -w @bizmgmt/api",
    "dev:web": "npm run dev -w @bizmgmt/web",
    "dev:worker": "npm run dev -w @bizmgmt/worker",
    "clean": "node scripts/clean.mjs",
    "test:e2e": "npm run test:e2e -w @bizmgmt/web",
    "db:migrate": "npm run db:migrate -w @bizmgmt/api",
    "dev:db": "node scripts/dev-db.mjs",
    "db:seed": "npm run db:seed -w @bizmgmt/api",
    "stock:reconcile": "npm run stock:reconcile -w @bizmgmt/api"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.4",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
